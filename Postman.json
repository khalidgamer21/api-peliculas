  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Crear generos\") pm.collectionVariables.set(\"runId\", Date.now().toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Generos",
      "item": [
        {
          "name": "Crear generos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/generos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Comedia\",\n  \"estado\": \"Activo\",\n  \"descripcion\": \"Historias de humor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"generosId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
